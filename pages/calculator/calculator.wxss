/* 计算器主页样式：简洁卡片式，主题蓝 #1A6BFF */
.page {
  min-height: 100vh;
  background: #F5F6FA;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 分段切换 */
.seg {
  display: flex;
  border: 1rpx solid #E3E6EC;
  border-radius: 16rpx;
  overflow: hidden;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  color: #555555;
  background: #FFFFFF;
}
.seg-item-active {
  background: #E8F0FF;
  color: #1A6BFF;
  font-weight: 600;
}

/* 表单字段 */
.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
}
.field-label {
  font-size: 30rpx;
  color: #333333;
}
.field-input {
  flex: 0 0 360rpx;
  text-align: right;
  font-size: 30rpx;
  color: #1A6BFF;
  border: 1rpx solid #E3E6EC;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  background: #FAFBFD;
}
.ratio-slider {
  margin: 8rpx 0 4rpx;
}
.derived-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  background: #EEF4FF;
  border-radius: 12rpx;
  margin-top: 12rpx;
}
.derived-label {
  font-size: 30rpx;
  color: #333333;
}
.derived-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A6BFF;
}

/* 结果区 */
.result-card {
  align-items: flex-start;
}
.monthly-label {
  font-size: 28rpx;
  color: #888888;
}
.monthly-value {
  display: block;
  font-size: 80rpx;
  font-weight: 700;
  color: #1A6BFF;
  line-height: 1.2;
  margin: 8rpx 0;
}
.decrease {
  display: block;
  font-size: 26rpx;
  color: #888888;
  margin-bottom: 8rpx;
}
.result-grid {
  display: flex;
  width: 100%;
  margin-top: 16rpx;
}
.result-cell {
  flex: 1;
  background: #F5F6FA;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-right: 16rpx;
}
.result-cell:last-child {
  margin-right: 0;
}
.result-cell-label {
  display: block;
  font-size: 24rpx;
  color: #888888;
}
.result-cell-value {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
  margin-top: 6rpx;
}
.cost-line {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #666666;
}
.cost-dot {
  margin: 0 12rpx;
  color: #BBBBBB;
}

/* 饼图 */
.chart-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}
.chart-body {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.pie-canvas {
  width: 200px;
  height: 200px;
}
.legend {
  flex: 1;
  padding-left: 32rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}
.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 14rpx;
}
.legend-dot-principal {
  background: #1A6BFF;
}
.legend-dot-interest {
  background: #D9E2F3;
}
.legend-text {
  font-size: 26rpx;
  color: #555555;
}

/* 按钮 */
.actions {
  margin-top: 8rpx;
}
.btn {
  border-radius: 16rpx;
  font-size: 32rpx;
  margin-bottom: 20rpx;
}
.btn::after {
  border: none;
}
.btn-primary {
  background: #1A6BFF;
  color: #FFFFFF;
}
.btn-outline {
  background: #FFFFFF;
  color: #1A6BFF;
  border: 1rpx solid #1A6BFF;
}

/* 页脚 */
.footer {
  text-align: center;
  padding: 24rpx 0 12rpx;
  font-size: 24rpx;
  color: #999999;
}
